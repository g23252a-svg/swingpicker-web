+RECOVERY_RET5_STRONG_OVERHEAT_MIN = 10.0
+RECOVERY_VWAP_FOMO_MIN = 20.0
+RECOVERY_VWAP_STRICT_MIN = 15.0
+RECOVERY_POC_FOMO_MIN = 60.0
+RECOVERY_POC_STRICT_MIN = 40.0
+RECOVERY_WEAK_PULLBACK_RET5 = -10.0
